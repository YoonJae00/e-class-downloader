#!/bin/bash
# 현재 파일이 있는 디렉토리로 이동
cd "$(dirname "$0")"

echo "==========================================="
echo "   한성대 e-Class 영상 자동 다운로더 실행"
echo "==========================================="
echo ""

# Python 실행 (Mac은 기본적으로 python3를 사용합니다)
python3 main.py

echo ""
echo "==========================================="
echo "작업이 완료되었습니다."
read -n 1 -s -p "아무 키나 누르면 터미널이 종료됩니다..."
exit
